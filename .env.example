# VietDub packaged defaults. Secrets are entered in the app and stored only in
# the current user's application-data directory.
AETHER_TRANSLATION_PROVIDER=openai-compatible
AETHER_LOCAL_TRANSLATION_BASE_URL=http://127.0.0.1:20128/v1
AETHER_LOCAL_TRANSLATION_MODEL=translate
AETHER_LOCAL_TRANSLATION_API_KEY=

NVIDIA_API_KEY=
NVIDIA_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
HF_TOKEN=
NGROK_AUTHTOKEN=

AETHER_TTS_PROVIDER=edge
AETHER_TTS_FALLBACK_TO_EDGE=1
AETHER_PREFER_LOCAL_GPU=1
OMNIVOICE_API_URL=
OMNIVOICE_API_KEY=

AETHER_SOURCE_FIRST_TRANSLATION_BATCH_CUES=150
AETHER_SOURCE_FIRST_TRANSLATION_BATCH_CHARS=5000
AETHER_SEMANTIC_NORMALIZE_BATCH_CUES=80
AETHER_SEMANTIC_NORMALIZE_BATCH_CHARS=1000
AETHER_EDGE_CONCURRENCY=6
AETHER_AUDIO_BED_MODE=hybrid
AETHER_RENDER_QUALITY=balanced
AETHER_SUBTITLE_LINE_MAX_CHARS=140

# Public Douyin/TikTok fallback when yt-dlp requires browser cookies.
# Set to 0 only when third-party download services must be disabled.
AETHER_THIRDPARTY_DOWNLOAD_ENABLED=1
AETHER_DOUYIN_COOKIES_FILE=
AETHER_DOUYIN_COOKIES_FROM_BROWSER=
