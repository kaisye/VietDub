{
  "name": "videodubbing",
  "private": true,
  "version": "1.3.0",
  "scripts": {
    "dev:api": "python -m uvicorn app.main:app --reload --host 127.0.0.1 --port 8386 --app-dir apps/api",
    "test:api": "pytest apps/api/tests",
    "dev:desktop-web": "npm --workspace apps/desktop run dev",
    "build:desktop-web": "npm --workspace apps/desktop run build",
    "desktop:dev": "npm --workspace apps/desktop run tauri dev",
    "build:backend": "powershell -ExecutionPolicy Bypass -File apps/desktop/scripts/build-backend.ps1",
    "desktop:build": "npm run build:backend && npm --workspace apps/desktop run tauri build",
    "release:windows": "powershell -ExecutionPolicy Bypass -File scripts/build-release.ps1",
    "test:distribution": "powershell -ExecutionPolicy Bypass -File scripts/test-distribution.ps1"
  },
  "workspaces": [
    "apps/desktop"
  ]
}
