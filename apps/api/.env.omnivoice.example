# Local NVIDIA OmniVoice service
OMNIVOICE_MODEL_ID=k2-fsa/OmniVoice
OMNIVOICE_RUNTIME=auto
OMNIVOICE_DEVICE_MAP=auto
OMNIVOICE_HOST=127.0.0.1
OMNIVOICE_PORT=8008
OMNIVOICE_OUTPUT_DIR=storage/omnivoice-outputs
OMNIVOICE_LOAD_ON_STARTUP=1
OMNIVOICE_LOAD_ASR=0
OMNIVOICE_API_KEY=
OMNIVOICE_LOG_LEVEL=INFO

# Aether Studio API
AETHER_TTS_PROVIDER=omnivoice
OMNIVOICE_API_URL=http://127.0.0.1:8008
OMNIVOICE_TRANSPORT=fastapi
AETHER_OMNIVOICE_USE_SRT_ENDPOINT=1
AETHER_OMNIVOICE_SRT_ASYNC=1
