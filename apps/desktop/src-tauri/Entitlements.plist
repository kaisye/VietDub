<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    The frozen backend extracts Python.framework and native extension modules
    before starting FastAPI. Tauri signs external binaries with the hardened
    runtime, whose library validation otherwise rejects those PyInstaller
    payloads because their code-signing Team ID differs from the sidecar.
  -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
